# Copie para .env só para testes locais com `netlify dev` — NUNCA versione o
# .env real. Em produção, configure em Netlify → Site configuration →
# Environment variables.

# Token de longa duração da conta profissional @brasiljumbos
# (Instagram API with Instagram Login). Renovado automaticamente pela rotina
# agendada; troque aqui só se ele for revogado.
INSTAGRAM_ACCESS_TOKEN=

# Opcional: id numérico da conta. Vazio = usa /me.
INSTAGRAM_USER_ID=

# Opcional: versão da Graph API (ex.: v23.0). Vazio = versão padrão.
INSTAGRAM_GRAPH_VERSION=

# --- Seguidores em tempo real (/api/social-counts) -------------------------
# Instagram usa o token acima. As demais redes são opcionais: cada uma só
# entra na automação quando as suas variáveis estiverem preenchidas.

# YouTube Data API v3 (Google Cloud Console → Credenciais → Chave de API)
YOUTUBE_API_KEY=
# Opcional: id do canal (UC...). Vazio = procura pelo @BRASILJUMBOS.
YOUTUBE_CHANNEL_ID=

# Facebook: id da Página e token de acesso da Página (sem validade)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# TikTok Display API (app aprovado, escopo user.info.stats)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
